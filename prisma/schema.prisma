// Prisma schema for charityBox.
// Postgres is used everywhere (dev via Docker Compose, prod via Neon/Vercel Postgres);
// SQLite cannot persist on Vercel's read-only ephemeral filesystem.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A fundraising campaign. `version` is the per-campaign sequence counter that is
/// incremented (transactionally) with every donation insert; it provides the
/// authoritative ordering used by the live-thermometer monotonicity guarantee.
model Campaign {
  id            Int        @id @default(autoincrement())
  slug          String     @unique
  orgName       String
  title         String
  story         String
  heroImagePath String
  goalMinor     Int
  currency      String     @default("USD")
  deadline      DateTime
  timezone      String
  version       Int        @default(0)
  createdAt     DateTime   @default(now())
  donations     Donation[]
}

/// A single donation. All money is stored as integer minor units (cents) — never floats.
model Donation {
  id          Int      @id @default(autoincrement())
  campaignId  Int
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  amountMinor Int
  donorName   String?
  anonymous   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([campaignId])
}
